{
  "name": "@deepseek-ai/dsh-plan-execute",
  "description": "Slash command /pe: Pro-plan 闂?Flash-execute 闂?Pro-review over the subagent seam",
  "version": "0.1.19",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/114811136-cmd/dsh-plan-execute.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --platform=node --target=node20 --external:@deepseek-ai/* --outfile=lib/index.js",
    "pack": "pnpm pack"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.0",
    "@deepseek-ai/dsh-agent": ">=0.1.0",
    "@deepseek-ai/dsh-commands": ">=0.1.0",
    "@deepseek-ai/dsh-llm": ">=0.1.0",
    "@deepseek-ai/dsh-subagent": ">=0.1.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0",
    "@deepseek-ai/dsh-user-questions": ">=0.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}












